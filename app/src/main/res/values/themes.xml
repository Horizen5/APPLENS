<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- HyperOS 明亮风格主题 -->
    <style name="Theme.ActivityScanner" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hyper_accent</item>
        <item name="colorPrimaryVariant">@color/hyper_accent_secondary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/hyper_accent_tertiary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurface">@color/hyper_bg_card</item>
        <item name="colorOnSurface">@color/hyper_text_primary</item>
        <item name="android:windowBackground">@color/hyper_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorEdgeEffect">@color/hyper_accent</item>
    </style>

    <!-- ====== 卡片（大圆角 24dp，白色，细边框，阴影效果） ====== -->
    <style name="HyperCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- 次级卡片（稍小，用于内联） -->
    <style name="HyperCardSmall">
        <item name="android:background">@drawable/bg_card_small</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <!-- ====== 文字样式 ====== -->
    <style name="HyperTextHero">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HyperTextHeroSub">
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="HyperTextTitle">
        <item name="android:textColor">@color/hyper_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HyperTextTitleSmall">
        <item name="android:textColor">@color/hyper_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HyperTextBody">
        <item name="android:textColor">@color/hyper_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="HyperTextCaption">
        <item name="android:textColor">@color/hyper_text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="HyperTextData">
        <item name="android:textColor">@color/hyper_text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ====== 按钮 ====== -->
    <!-- 主按钮：蓝紫渐变，大圆角 -->
    <style name="HyperButtonPrimary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_gradient</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">26dp</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- 次级按钮：白色背景 + 蓝色边框/文字 -->
    <style name="HyperButtonSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/hyper_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="strokeColor">@color/hyper_divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <!-- 文本按钮 -->
    <style name="HyperButtonText" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/hyper_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <!-- ====== Chip ====== -->
    <style name="HyperChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/hyper_chip_text</item>
        <item name="chipBackgroundColor">@color/hyper_chip_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="HyperChipBlue" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/hyper_chip_blue_text</item>
        <item name="chipBackgroundColor">@color/hyper_chip_blue_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="HyperChipGreen" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/hyper_chip_green_text</item>
        <item name="chipBackgroundColor">@color/hyper_chip_green_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="HyperChipOrange" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/hyper_chip_orange_text</item>
        <item name="chipBackgroundColor">@color/hyper_chip_orange_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <style name="HyperChipRed" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@color/hyper_chip_red_text</item>
        <item name="chipBackgroundColor">@color/hyper_chip_red_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <!-- ====== 分割线 ====== -->
    <style name="HyperDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/hyper_divider</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
    </style>

    <!-- ====== 搜索框 ====== -->
    <style name="HyperSearchBox">
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>
